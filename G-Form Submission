        return p\n    raise FileNotFoundError(f\"Could not find {filename} — check /kaggle/input/\")\n\ntrain_full = pd.read_csv(find_file(\"train.csv\"))\ntest_df = pd.read_csv(find_file(\"test.csv\"))\nprint(\"train:\", train_full.shape, \"| test:\", test_df.shape)\nprint(\"test columns:\", test_df.columns.tolist())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-20T13:59:43.859271Z","iopub.execute_input":"2026-07-20T13:59:43.859657Z","iopub.status.idle":"2026-07-20T13:59:43.932797Z","shell.execute_reply.started":"2026-07-20T13:59:43.859616Z","shell.execute_reply":"2026-07-20T13:59:43.931942Z"}},"outputs":[{"name":"stdout","text":"train: (2000, 8) | test: (500, 7)\ntest columns: ['id', 'prompt', 'A', 'B', 'C', 'D', 'E']\n","output_type":"stream"}],"execution_count":5},{"id":"558c71e3-f778-4eac-9417-3ea1ce4bdf7a","cell_type":"code","source":"OPTION_COLS = [\"A\", \"B\", \"C\", \"D\", \"E\"]\nLABEL_MAP = {\"A\": 0, \"B\": 1, \"C\": 2, \"D\": 3, \"E\": 4}\n\ntrain_full[\"label\"] = train_full[\"answer\"].map(LABEL_MAP)\nassert train_full[\"label\"].isnull().sum() == 0\n\nMAX_LEN = 512\n\ndef format_mcq_text(row, prompt_col=\"prompt\"):\n    prompt_text = str(row[prompt_col])\n    options_text = \" \".join(f\"{opt}) {row[opt]}\" for opt in OPTION_COLS)\n    return prompt_text, options_text\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-20T13:59:43.935466Z","iopub.execute_input":"2026-07-20T13:59:43.935788Z","iopub.status.idle":"2026-07-20T13:59:43.952091Z","shell.execute_reply.started":"2026-07-20T13:59:43.935746Z","shell.execute_reply":"2026-07-20T13:59:43.951463Z"}},"outputs":[],"execution_count":6},{"id":"1e91050d-c3b9-4f5d-8cad-3c3e70e055dc","cell_type":"markdown","source":"## Train / Validation Split\n\nStratified 80/20 on `label` via sklearn, so class balance is preserved and Q10 has a labeled, unseen-during-training validation set.","metadata":{}},{"id":"1b274d73-a105-4f6f-9fc9-45549ed1f207","cell_type":"code","source":"# sklearn's stratified split has occasionally broken on Kaggle's preinstalled sklearn\n# (a bad in-place upgrade -> ImportError); fall back to a manual per-class split if that happens.\ntry:\n    train_df, val_df = train_test_split(\n        train_full, test_size=0.2, stratify=train_full[\"label\"], random_state=SEED\n    )\nexcept ImportError:\n    rng = np.random.default_rng(SEED)\n    val_idx = []\n    for _, g in train_full.groupby(\"label\"):\n        idx = g.index.to_numpy().copy()\n        rng.shuffle(idx)\n        val_idx.extend(idx[:int(round(len(idx) * 0.2))])\n    val_mask = train_full.index.isin(val_idx)\n    train_df, val_df = train_full[~val_mask], train_full[val_mask]\n\ntrain_df = train_df.reset_index(drop=True)\nval_df = val_df.reset_index(drop=True)\n\nprint(\"train_df:\", train_df.shape, \"| val_df:\", val_df.shape)\nprint(\"val label balance:\\n\", val_df[\"label\"].value_counts(normalize=True).sort_index())\nassert len(val_df) >= 100, \"Need >=100 val rows for Q10\"\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-20T13:59:43.953209Z","iopub.execute_input":"2026-07-20T13:59:43.95364Z","iopub.status.idle":"2026-07-20T13:59:43.984117Z","shell.execute_reply.started":"2026-07-20T13:59:43.953614Z","shell.execute_reply":"2026-07-20T13:59:43.983228Z"}},"outputs":[{"name":"stdout","text":"train_df: (1600, 9) | val_df: (400, 9)\nval label balance:\n label\n0    0.1850\n1    0.2450\n2    0.2300\n3    0.1775\n4    0.1625\nName: proportion, dtype: float64\n","output_type":"stream"}],"execution_count":7},{"id":"10324ab8-8747-4f52-ac70-82938be77bde","cell_type":"markdown","source":"## Fine-Tune Both Models\n\nDeBERTa-v3's disentangled attention (custom `XSoftmax` masking) produces NaN loss under fp16 — and under bf16 on GPUs that don't actually support it in hardware (Kaggle's T4/P100 don't; only Ampere+ does). So `safe_mode=True` uses bf16 **only if the GPU genuinely supports it**, otherwise falls back to plain fp32, plus grad clipping and a lower LR. RoBERTa trains fp16 as usual — it doesn't have this issue.","metadata":{}},{"id":"2a2b2c73-e45b-42c0-bddd-59810607ba85","cell_type":"code","source":"def build_seq_cls_dataset(dataframe, tokenizer, max_length=MAX_LEN, prompt_col=\"prompt\"):\n    pairs = [format_mcq_text(row, prompt_col) for _, row in dataframe.iterrows()]\n    prompts, options = zip(*pairs)\n    enc = tokenizer(list(prompts), list(options), padding=\"max_length\", truncation=True, max_length=max_length)\n    return Dataset.from_list([\n        {\"input_ids\": enc[\"input_ids\"][i], \"attention_mask\": enc[\"attention_mask\"][i],\n         \"labels\": int(dataframe.iloc[i][\"label\"])}\n        for i in range(len(dataframe))\n    ])\n\n\ndef finetune_seq_cls(model_name, train_df, val_df, run_tag, epochs=3, batch_size=8,\n                      lr=2e-5, safe_mode=False):\n    tokenizer = AutoTokenizer.from_pretrained(model_name)\n    model = AutoModelForSequenceClassification.from_pretrained(model_name, num_labels=5).to(device)\n\n    train_ds = build_seq_cls_dataset(train_df, tokenizer)\n    val_ds = build_seq_cls_dataset(val_df, tokenizer)\n\n    args = TrainingArguments(\n        output_dir=f\"./m5-{run_tag}\",\n        num_train_epochs=epochs,\n        per_device_train_batch_size=batch_size,\n        per_device_eval_batch_size=batch_size * 2,\n        learning_rate=1e-5 if safe_mode else lr,\n        warmup_ratio=0.1 if safe_mode else 0.0,\n        max_grad_norm=1.0,\n        eval_strategy=\"epoch\",\n        save_strategy=\"no\",\n        logging_steps=20,\n        fp16=torch.cuda.is_available() and not safe_mode,  # plain fp32 for DeBERTa, fp16 for RoBERTa\n        report_to=[\"wandb\"],\n        run_name=f\"m5-{run_tag}-finetune\",\n        seed=SEED,\n    )\n    print(f\"{run_tag}: fp16={args.fp16}, lr={args.learning_rate}\")\n\n    trainer = Trainer(model=model, args=args, train_dataset=train_ds, eval_dataset=val_ds)\n    trainer.train()\n    eval_metrics = trainer.evaluate()\n    print(f\"{run_tag} eval metrics:\", eval_metrics)\n\n    model.eval()\n    return model, tokenizer, eval_metrics\n\ntok = AutoTokenizer.from_pretrained(\"microsoft/deberta-v3-small\")\nmdl = AutoModelForSequenceClassification.from_pretrained(\"microsoft/deberta-v3-small\", num_labels=5).to(device)\nds = build_seq_cls_dataset(train_df.iloc[:8], tok)\nbatch = {k: torch.tensor(ds[k]).to(device) for k in [\"input_ids\", \"attention_mask\", \"labels\"]}\nout = mdl(**batch)\nprint(\"initial loss:\", out.loss.item(), \"| expected ~1.61 for random 5-class\")\nout.loss.backward()\ngrads_finite = all(p.grad is None or torch.isfinite(p.grad).all() for p in mdl.parameters())\nprint(\"all grads finite:\", grads_finite)\ndel mdl, tok, ds, batch, out\ntorch.cuda.empty_cache()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-20T13:59:43.985197Z","iopub.execute_input":"2026-07-20T13:59:43.985566Z","iopub.status.idle":"2026-07-20T13:59:52.297067Z","shell.execute_reply.started":"2026-07-20T13:59:43.985527Z","shell.execute_reply":"2026-07-20T13:59:52.295196Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/52.0 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0a00f7a1abc7418d8f4c40df16247e74"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/578 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ff9ef5d752cc4734a0c89f38c29484dd"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"spm.model:   0%|          | 0.00/2.46M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"6bb1476299874f19bd3fee0a789c63fb"}},"metadata":{}},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/transformers/convert_slow_tokenizer.py:559: UserWarning: The sentenc