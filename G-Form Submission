e Utilities\n\n`apk` matches the Day-9 bootcamp convention. `batch_infer_probs` returns softmax probabilities, shape `[N, 5]`.","metadata":{}},{"id":"99ba90e0-e45c-4136-af1e-cb7ed8ec58b6","cell_type":"code","source":"def apk(actual, predicted, k=3):\n    predicted = predicted[:k]\n    return 1 / (predicted.index(actual) + 1) if actual in predicted else 0\n\ndef mapk(actuals, predicted_lists, k=3):\n    return float(np.mean([apk(a, p, k) for a, p in zip(actuals, predicted_lists)]))\n\ndef top1_letter(probs):\n    return OPTION_COLS[int(np.argmax(probs))]\n\ndef top3_string(probs):\n    order = np.argsort(-probs)[:3]\n    return \" \".join(OPTION_COLS[i] for i in order)\n\n@torch.no_grad()\ndef batch_infer_probs(model, tokenizer, dataframe, max_length=MAX_LEN, batch_size=32, prompt_col=\"prompt\"):\n    model.eval()\n    texts = [format_mcq_text(row, prompt_col) for _, row in dataframe.iterrows()]\n    all_probs = []\n    for i in tqdm(range(0, len(texts), batch_size), desc=\"inferring\"):\n        enc = tokenizer(texts[i:i+batch_size], padding=True, truncation=True,\n                         max_length=max_length, return_tensors=\"pt\").to(device)\n        probs = F.softmax(model(**enc).logits, dim=-1).cpu().numpy()\n        all_probs.append(probs)\n    return np.vstack(all_probs)\n\nW_DEBERTA, W_ROBERTA = 0.7, 0.3\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-20T14:12:55.416315Z","iopub.execute_input":"2026-07-20T14:12:55.4172Z","iopub.status.idle":"2026-07-20T14:12:55.426801Z","shell.execute_reply.started":"2026-07-20T14:12:55.417163Z","shell.execute_reply":"2026-07-20T14:12:55.425981Z"}},"outputs":[],"execution_count":10},{"id":"fc2611bf-161b-4de6-b1af-f6fdd36cb864","cell_type":"markdown","source":"## Q1–Q4 — Row 25 of `test.csv`","metadata":{}},{"id":"7d79dfe0-5eef-4639-b625-6facf10f8330","cell_type":"code","source":"row25 = test_df.iloc[[25]]\n\ndeberta_probs_25 = batch_infer_probs(deberta_model, deberta_tokenizer, row25)[0]\nroberta_probs_25 = batch_infer_probs(roberta_model, roberta_tokenizer, row25)[0]\n\nq1_letter = top1_letter(deberta_probs_25)\nq1_prob = round(float(deberta_probs_25.max()), 4)\n\nsimple_avg_25 = (deberta_probs_25 + roberta_probs_25) / 2\nq2_letter = top1_letter(simple_avg_25)\n\nweighted_avg_25 = W_DEBERTA * deberta_probs_25 + W_ROBERTA * roberta_probs_25\nq3_letter = top1_letter(weighted_avg_25)\n\nq4_answer = top3_string(weighted_avg_25)\n\nprint(\"DeBERTa probs:  \", np.round(deberta_probs_25, 4))\nprint(\"RoBERTa probs:  \", np.round(roberta_probs_25, 4))\nprint(\"Simple avg:     \", np.round(simple_avg_25, 4))\nprint(\"Weighted avg:   \", np.round(weighted_avg_25, 4))\nprint(f\"\\nQ1: {q1_letter}, probability of {q1_letter} = {q1_prob}\")\nprint(f\"Q2: {q2_letter}\")\nprint(f\"Q3: {q3_letter}\")\nprint(f\"Q4: {q4_answer}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-20T14:13:00.602007Z","iopub.execute_input":"2026-07-20T14:13:00.602866Z","iopub.status.idle":"2026-07-20T14:13:00.710571Z","shell.execute_reply.started":"2026-07-20T14:13:00.602833Z","shell.execute_reply":"2026-07-20T14:13:00.709893Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"inferring:   0%|          | 0/1 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"7905fc099eb7477e8938a4eec672206f"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"inferring:   0%|          | 0/1 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8e0bec659cb54c30bf3b470b38d27fea"}},"metadata":{}},{"name":"stdout","text":"DeBERTa probs:   [0.105  0.3092 0.1033 0.2463 0.2362]\nRoBERTa probs:   [0.003  0.002  0.0042 0.0022 0.9886]\nSimple avg:      [0.054  0.1556 0.0538 0.1243 0.6124]\nWeighted avg:    [0.0744 0.217  0.0736 0.1731 0.4619]\n\nQ1: B, probability of B = 0.3092\nQ2: E\nQ3: E\nQ4: E B D\n","output_type":"stream"}],"execution_count":11},{"i