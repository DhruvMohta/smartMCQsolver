\n        texts = build_choice_texts(row)\n        enc = tokenizer(\n            texts,\n            padding=\"max_length\",\n            truncation=True,\n            max_length=max_length,\n        )\n        records.append({\n            \"input_ids\": enc[\"input_ids\"],          # [5, max_length]\n            \"attention_mask\": enc[\"attention_mask\"], # [5, max_length]\n            \"labels\": int(LABEL_MAP[row[\"answer\"]]),\n        })\n    return Dataset.from_list(records)\n\nhf_dataset_100 = build_mc_dataset(df.iloc[:100], tokenizer)\n\nfirst_item = hf_dataset_100[0]\ninput_ids_shape = (len(first_item[\"input_ids\"]), len(first_item[\"input_ids\"][0]))\nprint(\"First item input_ids shape:\", input_ids_shape)\nassert input_ids_shape == (5, MAX_LEN)\n\nq8_answer = input_ids_shape[0]\nprint(\"Q8 ANSWER — tokenized choices stored in input_ids:\", q8_answer)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T14:11:33.584706Z","iopub.execute_input":"2026-07-16T14:11:33.585114Z","iopub.status.idle":"2026-07-16T14:11:33.840381Z","shell.execute_reply.started":"2026-07-16T14:11:33.585079Z","shell.execute_reply":"2026-07-16T14:11:33.838911Z"}},"outputs":[{"name":"stdout","text":"First item input_ids shape: (5, 128)\nQ8 ANSWER — tokenized choices stored in input_ids: 5\n","output_type":"stream"}],"execution_count":19},{"id":"1646b72d","cell_type":"markdown","source":"## Tiny Fine-Tuning and Inference\n\n### Q9 — Tiny LoRA Fine-Tuning\n\nFine-tune the LoRA multiple-choice model on the first 32 rows with `Trainer`:\n`max_length=64, per_device_train_batch_size=4, gradient_accumulation_steps=1, max_steps=4`.\n\n**What is the final `global_step` reported by the Trainer?**","metadata":{}},{"id":"cec9c1d0","cell_type":"code","source":"TRAIN_MAX_LEN = 64\nhf_dataset_32 = build_mc_dataset(df.iloc[:32], tokenizer, max_length=TRAIN_MAX_LEN)\n\n\ndef mc_collate_fn(features):\n    batch = {\n        \"input_ids\": torch.tensor([f[\"input_ids\"] for f in features], dtype=torch.long),\n        \"attention_mask\": torch.tensor([f[\"attention_mask\"] for f in features], dtype=torch.long),\n        \"labels\": torch.tensor([f[\"labels\"] for f in features], dtype=torch.long),\n    }\n    return batch\n\n\ntraining_args = TrainingArguments(\n    output_dir=\"./m4_lora_tiny_run\",\n    per_device_train_batch_size=4,\n    gradient_accumulation_steps=1,\n    max_steps=4,\n    logging_steps=1,\n    save_strategy=\"no\",\n    report_to=[\"wandb\"],\n    run_name=\"m4-lora-tiny-finetune\",\n    seed=SEED,\n)\n\ntrainer = Trainer(\n    model=peft_model,\n    args=training_args,\n    train_dataset=hf_dataset_32,\n    data_collator=mc_collate_fn,\n)\n\ntrain_result = trainer.train()\n\nq9_answer = trainer.state.global_step\nprint(\"Q9 ANSWER — final global_step:\", q9_answer)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T14:11:44.610956Z","iopub.execute_input":"2026-07-16T14:11:44.611432Z","iopub.status.idle":"2026-07-16T14:12:08.245744Z","shell.execute_reply.started":"2026-07-16T14:11:44.611392Z","shell.execute_reply":"2026-07-16T14:12:08.24488Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/torch/utils/data/dataloader.py:775: UserWarning: 'pin_memory' argument is set as true but no accelerator is found, then device pinned memory won't be used.\n  super().__init__(loader)\n[transformers] `use_return_dict` is deprecated! Use `return_dict` instead!\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"\n    <div>\n      \n      <progress value='4' max='4' style='width:300px; height:20px; vertical-align: middle;'></progress>\n      [4/4 00:17, Epoch 0/1]\n    </div>\n    <table border=\"1\" class=\"dataframe\">\n  <thead>\n <tr style=\"text-align: left;\">\n      <th>Step</th>\n      <th>Training Loss</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>1</td>\n      <td>1.606301</td>\n    </tr